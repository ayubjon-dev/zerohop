<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-program": the release workflow
  uploads zerohop.exe alone, and SignPath signs it. Kept here so that the
  configuration in SignPath can be checked against the repository.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="zerohop.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
