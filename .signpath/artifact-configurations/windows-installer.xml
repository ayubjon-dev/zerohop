<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-installer": the release workflow
  uploads the installer alone, built around the already signed program, and
  SignPath signs it. Kept here so that the configuration in SignPath can be
  checked against the repository.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Zerohop-*-windows-x64-setup.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
